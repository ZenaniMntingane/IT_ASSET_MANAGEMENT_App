<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Dashboard header -->
        <LinearLayout
            android:id="@+id/toolbarDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1677E8"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IT ASSET MANAGEMENT"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/txtDashboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Manage your IT assets in one place"
                android:textColor="#EAF3FF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- User profile card -->
        <LinearLayout
            android:id="@+id/cardProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Profile icon"
                android:padding="12dp"
                android:src="@drawable/ic_account_circle"
                />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back,"
                    android:textColor="#718096"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="User Name"
                    android:textColor="#1A202C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="IT Staff"
                    android:textColor="#1677E8"
                    android:textSize="13sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Statistics heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="Overview"
            android:textColor="#1A202C"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Statistics row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Total assets"
                    android:src="@drawable/ic_dashboard_computer"
                    app:tint="#1677E8"
                    />

                <TextView
                    android:id="@+id/txtTotalAssets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textColor="#1A202C"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Assets"
                    android:textColor="#718096"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Reports"
                    android:src="@drawable/ic_dashboard_report"
                    app:tint="#2196F3" />

                <TextView
                    android:id="@+id/txtTotalReports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textColor="#1A202C"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports"
                    android:textColor="#718096"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Statistics row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Transfers"
                    android:src="@drawable/ic_dashboard_transfer"
                    app:tint="#FF9800" />

                <TextView
                    android:id="@+id/txtTotalTransfers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textColor="#1A202C"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transfers"
                    android:textColor="#718096"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="Allocations"
                    android:src="@drawable/ic_dashboard_allocate"
                    app:tint="#10B981" />

                <TextView
                    android:id="@+id/txtTotalAllocations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textColor="#1A202C"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allocations"
                    android:textColor="#718096"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:text="Quick Actions"
            android:textColor="#1A202C"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Add Asset -->
        <LinearLayout
            android:id="@+id/cardAddAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_blue"
                android:contentDescription="Add asset"
                android:padding="10dp"
                android:src="@drawable/ic_add"
                app:tint="#1677E8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Add New Asset"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

        <!-- Transfer Asset -->
        <LinearLayout
            android:id="@+id/cardTransferAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_orange"
                android:contentDescription="Transfer asset"
                android:padding="10dp"
                android:src="@drawable/ic_dashboard_transfer"
                app:tint="#F59E0B" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Transfer Asset"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

        <!-- Allocate Asset -->
        <LinearLayout
            android:id="@+id/cardAllocateAsset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_green"
                android:contentDescription="Allocate asset"
                android:padding="10dp"
                android:src="@drawable/ic_dashboard_allocate"
                app:tint="#10B981" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Allocate Asset"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

        <!-- Asset Personnel -->
        <LinearLayout
            android:id="@+id/cardAssetPersonnel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_purple"
                android:contentDescription="Asset personnel"
                android:padding="10dp"
                android:src="@drawable/ic_people"
                app:tint="#8B5CF6" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Asset Personnel"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

        <!-- Maintenance -->
        <LinearLayout
            android:id="@+id/cardMaintenance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_teal"
                android:contentDescription="Maintenance"
                android:padding="10dp"
                android:src="@drawable/ic_maintenance_1_"
                app:tint="#0D9488" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Maintenance"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

        <!-- Reports -->
        <LinearLayout
            android:id="@+id/cardReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_purple"
                android:contentDescription="Reports"
                android:padding="10dp"
                android:src="@drawable/ic_dashboard_report"
                app:tint="#8B5CF6" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Reports"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

        <!-- Audit Trail -->
        <LinearLayout
            android:id="@+id/cardAuditTrail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_blue"
                android:contentDescription="Audit trail"
                android:padding="10dp"
                android:src="@drawable/ic_dashboard_audit"
                app:tint="#1677E8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Audit Trail"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

        <!-- Asset History -->
        <LinearLayout
            android:id="@+id/cardAssetHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/dashboard_icon_teal"
                android:contentDescription="Asset history"
                android:padding="10dp"
                android:src="@drawable/ic_dashboard_history"
                app:tint="#0D9488" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Asset History"
                android:textColor="#1A202C"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Open"
                android:src="@drawable/ic_forward_arrow"
                app:tint="#718096" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
