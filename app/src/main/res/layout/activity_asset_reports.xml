<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/asset_reports"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/generate_reports_from_your_it_asset_records"
            android:textSize="15sp"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="25dp" />


        <!-- ============================= -->
        <!-- ALL ASSETS REPORT -->
        <!-- ============================= -->

        <LinearLayout
            android:id="@+id/reportAllAssets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="15dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_assets_report"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_and_export_all_assets_stored_in_firebase"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- STATUS REPORT -->
        <!-- ============================= -->

        <LinearLayout
            android:id="@+id/reportStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="15dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asset_status_report"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_assets_according_to_their_condition_or_status"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- CATEGORY REPORT -->
        <!-- ============================= -->

        <LinearLayout
            android:id="@+id/reportCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="15dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asset_category_report"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_assets_by_type_such_as_laptops_printers_and_desktops"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- LOCATION REPORT -->
        <!-- ============================= -->

        <LinearLayout
            android:id="@+id/reportLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="15dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asset_location_report"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_where_assets_are_currently_located"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- MAINTENANCE REPORT -->
        <!-- ============================= -->

        <LinearLayout
            android:id="@+id/reportMaintenance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="15dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/maintenance_report"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_assets_that_require_maintenance_repair_or_replacement"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- ALLOCATION REPORT -->
        <!-- ============================= -->

        <LinearLayout
            android:id="@+id/reportAllocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="25dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/asset_allocation_report"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1565C0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/view_assigned_users_departments_and_asset_locations"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginTop="5dp" />

        </LinearLayout>


        <!-- ============================= -->
        <!-- EXPORT BUTTON -->
        <!-- ============================= -->

        <Button
            android:id="@+id/btnExportReport"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/export_report"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
