+            .child(assetNumber)
+            .push()
+            .key
+            ?: return
+
+        val historyData  = hashMapOf<String, Any>(
+            "action" to action,
+            "description" to description,
+            "performedBy" to performedBy,
+            "timestamp" to System.currentTimeMillis()
+        )
+
+        database
+            .child(assetNumber)
+            .child(historyId)
+            .setValue(historyData)
+            .addOnFailureListener { error ->
+                error.printStackTrace()
+            }
+    }
+}
