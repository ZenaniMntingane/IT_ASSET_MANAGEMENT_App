@@ -0,0 +1,80 @@
+package com.example.it_asset_management_app
+
+import com.google.firebase.auth.FirebaseAuth
+import com.google.firebase.firestore.FieldValue
+import com.google.firebase.firestore.FirebaseFirestore
+
+object AuditLogger {
+
+    private val auth = FirebaseAuth.getInstance()
+    private val db = FirebaseFirestore.getInstance()
+
+    fun logAction(
+        action: String,
+        description: String,
+        assetNumber: String = "",
+        onComplete: ((Boolean, String?) -> Unit)? = null
+    ) {
+        val user = auth.currentUser
+
+        if (user == null) {
+            onComplete?.invoke(false, "No signed-in user.")
+            return
+        }
+
+        // Record the action using the authenticated user's UID.
+        db.collection("users")
+            .document(user.uid)
+            .get()
+            .addOnSuccessListener { userDoc ->
+
+                val userName = userDoc.getString("name")
+                    ?: userDoc.getString("fullName")
+                    ?: userDoc.getString("email")
+                    ?: user.email
+                    ?: "Unknown user"
+
+                val record = hashMapOf(
+                    "action" to action,
+                    "description" to description,
+                    "assetNumber" to assetNumber,
+                    "performedBy" to userName,
+                    "performedByUid" to user.uid,
+                    "performedByEmail" to user.email,
+                    "timestamp" to FieldValue.serverTimestamp()
+                )
+
+                db.collection("auditTrails")
+                    .add(record)
+                    .addOnSuccessListener {
+                        android.util.Log.d(
+                            "AuditLogger",
+                            "Audit record saved: $action"
+                        )
+                        onComplete?.invoke(true, null)
+                    }
+                    .addOnFailureListener { error ->
+                        android.util.Log.e(
+                            "AuditLogger",
+                            "Failed to save audit record",
+                            error
+                        )
+                        onComplete?.invoke(
+                            false,
+                            error.localizedMessage
+                        )
+                    }
+            }
+            .addOnFailureListener { error ->
+                android.util.Log.e(
+                    "AuditLogger",
+                    "Could not read user profile",
+                    error
+                )
+                onComplete?.invoke(
+                    false,
+                    error.localizedMessage
+                )
+            }
+    }
+}
