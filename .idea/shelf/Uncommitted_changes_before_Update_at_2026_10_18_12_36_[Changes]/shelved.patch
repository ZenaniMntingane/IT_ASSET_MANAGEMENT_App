+    // ---------------------------------------------------------
+    // TIMESTAMP HELPERS
+    // ---------------------------------------------------------
+
+    private fun readRealtimeTimestamp(
+        snapshot: DataSnapshot
+    ): Long {
+        val value = snapshot.child("timestamp").value
+            ?: snapshot.child("savedAt").value
+            ?: snapshot.child("transferredAt").value
+
+        return convertTimestamp(value)
+    }
+
+    private fun convertTimestamp(value: Any?): Long {
+        return when (value) {
+            is Timestamp -> value.toDate().time
+            is Date -> value.time
+
+            is Number -> {
+                val number = value.toLong()
+
+                // Values that look like epoch seconds are converted
+                // to milliseconds.
+                if (number in 1L..9_999_999_999L) {
+                    number * 1000L
+                } else {
+                    number
+                }
+            }
+
+            is String -> {
+                val number = value.toLongOrNull()
+
+                if (number != null) {
+                    if (number in 1L..9_999_999_999L) {
+                        number * 1000L
+                    } else {
+                        number
+                    }
+                } else {
+                    parseDate(value)
+                }
+            }
+
+            else -> 0L
+        }
+    }
+
+    private fun parseDate(value: String): Long {
+        val formats = listOf(
+            "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
+            "yyyy-MM-dd'T'HH:mm:ss'Z'",
+            "yyyy-MM-dd HH:mm:ss"
+        )
+
+        for (pattern in formats) {
+            try {
+                val formatter =
+                    SimpleDateFormat(pattern, Locale.US)
+
+                formatter.isLenient = false
+                formatter.timeZone =
+                    java.util.TimeZone.getTimeZone("UTC")
+
+                return formatter.parse(value)?.time ?: continue
+            } catch (_: Exception) {
+                // Try the next format.
+            }
+        }
+
+        return 0L
+    }
