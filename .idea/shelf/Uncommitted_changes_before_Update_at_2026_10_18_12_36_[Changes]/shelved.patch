+
+        val oldUser =
+            document.getString("oldUser").orEmpty()
+
+        val newUser =
+            document.getString("newUser").orEmpty()
+
+        val oldDepartment =
+            document.getString("oldDepartment").orEmpty()
+
+        val newDepartment =
+            document.getString("newDepartment").orEmpty()
+
+        val oldLocation =
+            document.getString("oldLocation").orEmpty()
+
+        val newLocation =
+            document.getString("newLocation").orEmpty()
+
+        val details = mutableListOf<String>()
+
+        document.getString("description")
+            ?.takeIf { it.isNotBlank() }
+            ?.let { details.add(it) }
+
+        if (isTransfer) {
+            if (oldUser.isNotBlank() || newUser.isNotBlank()) {
+                details.add(
+                    "User: ${oldUser.ifBlank { "Unknown" }} → ${newUser.ifBlank { "Unknown" }}"
+                )
+            }
+
+            if (oldDepartment.isNotBlank() ||
+                newDepartment.isNotBlank()
+            ) {
+                details.add(
+                    "Department: ${oldDepartment.ifBlank { "Unknown" }} → ${newDepartment.ifBlank { "Unknown" }}"
+                )
+            }
+
+            if (oldLocation.isNotBlank() ||
+                newLocation.isNotBlank()
+            ) {
+                details.add(
+                    "Location: ${oldLocation.ifBlank { "Unknown" }} → ${newLocation.ifBlank { "Unknown" }}"
+                )
+            }
+
+            document.getString("verificationStatus")
+                ?.takeIf { it.isNotBlank() }
+                ?.let {
+                    details.add("Signature verification: $it")
+                }
+        }
+
+        val performer =
+            document.getString("performedBy")
+                ?: document.getString("transferredBy")
+                ?: document.getString("exportedBy")
+                ?: document.getString("transferredByUid")
+                ?: "Unknown User"
+
+        val performerUid =
+            document.getString("performedByUid")
+                ?: document.getString("transferredByUid")
+                ?: ""
+
+        return AuditRecord(
+            id = if (isTransfer) {
+                "transfer:${document.id}"
+            } else {
+                "firestore:${document.id}"
+            },
+            action = document.getString("action")
+                ?: if (isTransfer) "Asset Transferred"
+                else "Unknown Action",
+            description = details.joinToString("\n"),
+            assetNumber = document.getString("assetNumber").orEmpty(),
+            assetName = document.getString("assetName").orEmpty(),
+            performedBy = performer,
+            performedByUid = performerUid,
+            department = document.getString("department")
+                ?: newDepartment,
+            timestamp = timestamp,
+            source = if (isTransfer) {
+                "Firestore Transfers"
+            } else {
+                "Firestore Audit Trail"
+            }
+        )
+    }
