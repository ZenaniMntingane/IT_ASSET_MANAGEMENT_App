-        // Draw the user's signature
-        canvas.drawPath(
-            signaturePath,
-            signaturePaint
-        )
-
-        // Draw signature line
-        canvas.drawLine(
-            20f,
-            height - 30f,
-            width - 20f,
-            height - 30f,
-            linePaint
-        )
-    }
