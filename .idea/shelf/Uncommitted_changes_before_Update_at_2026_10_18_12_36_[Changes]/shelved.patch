+        allRecords.addAll(firestoreAuditRecords)
+        allRecords.addAll(firestoreTransferRecords)
+
+        // Remove duplicate events represented in more than one source.
+        val uniqueRecords = allRecords.distinctBy { record ->
+            listOf(
+                record.action.trim().lowercase(Locale.ROOT),
+                record.assetNumber.trim().lowercase(Locale.ROOT),
+                record.performedByUid.trim().lowercase(Locale.ROOT),
+                record.timestamp.toString(),
+                record.description.trim().lowercase(Locale.ROOT)
+            ).joinToString("|")
+        }.sortedByDescending { it.timestamp }
+
+        auditList.clear()
+        auditList.addAll(uniqueRecords)
+
+        updateStatistics()
+        displayFilteredRecords()
+    }
