+    // RSA DIGITAL SIGNATURE
+
+    private fun signPayload(
+        payload: String,
+        privateKey: PrivateKey
+    ): String {
+        val signer = Signature.getInstance(SIGNATURE_ALGORITHM)
+
+        signer.initSign(privateKey)
+        signer.update(payload.toByteArray(Charsets.UTF_8))
+
+        val signatureBytes = signer.sign()
+
+        check(signatureBytes.isNotEmpty()) {
+            "The signing operation returned an empty signature."
+        }
+
+        return Base64.encodeToString(
+            signatureBytes,
+            Base64.NO_WRAP
+        )
+    }
+
+    // VERIFY DIGITAL SIGNATURE
+
+    private fun verifyPayload(
+        payload: String,
+        signatureBase64: String,
+        publicKeyBase64: String
+    ): Boolean {
+        val publicKeyBytes = Base64.decode(
+            publicKeyBase64,
+            Base64.DEFAULT
+        )
+
+        val publicKey: PublicKey =
+            KeyFactory.getInstance("RSA").generatePublic(
+                X509EncodedKeySpec(publicKeyBytes)
+            )
+
+        val signatureBytes = Base64.decode(
+            signatureBase64,
+            Base64.DEFAULT
+        )
+
+        val verifier = Signature.getInstance(SIGNATURE_ALGORITHM)
+
+        verifier.initVerify(publicKey)
+        verifier.update(payload.toByteArray(Charsets.UTF_8))
+
+        return verifier.verify(signatureBytes)
+    }
+
+    // SHA-256 HASH
+
+    private fun sha256Hex(payload: String): String {
+        val digest = MessageDigest.getInstance(HASH_ALGORITHM)
+            .digest(payload.toByteArray(Charsets.UTF_8))
+
+        return digest.joinToString("") { byte ->
+            "%02x".format(byte.toInt() and 0xff)
+        }
+    }
